# ============================================================
# Nostrum · backend (Express) environment
# Copy to .env and fill in real values. NEVER commit .env.
# ============================================================

# Server
PORT=5000
NODE_ENV=development

# CORS (comma-separated origins)
CORS_ORIGIN=http://localhost:3000

# --- MongoDB ------------------------------------------------
# Must point at the SAME database as the Next.js app so both
# sides share the users collection.
MONGODB_URI=mongodb://127.0.0.1:27017/nostrum

# --- Auth ---------------------------------------------------
# MUST be identical to AUTH_SECRET in the frontend .env.local.
# The Express API verifies the Auth.js session JWT with this key.
AUTH_SECRET=

# Admin bootstrap: comma-separated emails auto-promoted to admin.
ADMIN_EMAILS=

# Seed script (scripts/seed-admin.js) credentials for the first admin.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=

# --- Email (TODO: wire later) -------------------------------
# Verification + password-reset emails are LOGGED TO CONSOLE until
# an email provider is chosen. See frontend src/lib/auth/mailer.ts.
RESEND_API_KEY=

# --- Payments (later, once the client decides Shopify vs Stripe) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Redis (optional: sessions cache / rate limiting, later)
REDIS_URL=
