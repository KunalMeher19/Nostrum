# ============================================================
# Nostrum · frontend (Next.js) environment
# Copy to .env.local and fill in real values. NEVER commit .env.local.
# ============================================================

# --- Auth.js (NextAuth v5) ----------------------------------
# Generate with: openssl rand -base64 32
# MUST be identical to JWT shared secret used by the Express backend
# (backend/.env AUTH_SECRET) so the API can verify session tokens.
AUTH_SECRET=

# Canonical app URL (used for OAuth callbacks in production)
# Local dev: http://localhost:3000
AUTH_URL=http://localhost:3000

# --- Google OAuth -------------------------------------------
# Create at https://console.cloud.google.com/apis/credentials
#  1. Create OAuth 2.0 Client ID (type: Web application)
#  2. Authorized JavaScript origins:  http://localhost:3000  (+ prod domain)
#  3. Authorized redirect URIs:
#       http://localhost:3000/api/auth/callback/google
#       https://<prod-domain>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- MongoDB ------------------------------------------------
# Atlas connection string, e.g.
# mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/nostrum?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/nostrum

# --- Admin bootstrap ----------------------------------------
# Comma-separated emails auto-promoted to the admin role on sign-in.
ADMIN_EMAILS=

# --- Email (TODO: wire later) -------------------------------
# Verification + password-reset emails are currently LOGGED TO THE
# SERVER CONSOLE instead of being sent. When the client provides an
# email provider, set the key below and implement the send in
# src/lib/auth/mailer.ts (see the TODO there for exact steps).
RESEND_API_KEY=

# --- Express API --------------------------------------------
# Base URL of the standalone backend (orders, admin, invoices).
NEXT_PUBLIC_API_URL=http://localhost:5000
